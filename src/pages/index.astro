---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<nav id="top-nav">
		<a href="/about">About</a>
		<a href="/projects">Projects</a>
		<a href="/playful">Playful</a>
	</nav>

	<!-- MLE Hero: wheel cycles images, then scrolls to About -->
	<section id="hero">
		<img id="bg-img" src="/images/aggie.png" alt="" />
		<h1 id="hero-title">
			<span class="title-line">Hi, I'm</span>
			<span class="title-line" id="line-ml"><span style="color:#000">Machine Learning</span></span>
			<span class="title-line">Engineer</span>
		</h1>
		<canvas id="mle-canvas"></canvas>
		<p id="drag-hint">← drag to explore angles →</p>
	</section>

</Layout>

<style>
	/* --- Hero / MLE gallery --- */
	#hero {
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #000;
		overflow: hidden;
		position: relative;
	}
	#hero-title {
		position: absolute;
		top: 5rem;
		left: 8vw;
		font-family: 'Impact', 'Arial Black', 'Haettenschweiler', sans-serif;
		font-size: 4rem;
		font-weight: 900;
		line-height: 1.05;
		color: #fff;
		opacity: 0.15;
		transform: scale(1);
		transform-origin: top left;
		transition: opacity 0.4s ease, transform 0.4s ease;
		pointer-events: none;
		z-index: 2;
		white-space: nowrap;
	}
	.title-line { display: block; }
	#line-ml {
		overflow: hidden;
		max-height: 0;
		opacity: 0;
		transition: max-height 0.4s ease, opacity 0.4s ease;
	}
	#bg-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: blur(20px);
		opacity: 0;
		transition: opacity 0.6s ease;
		z-index: 0;
		pointer-events: none;
		transform: scale(1.05); /* prevent blur edge artifacts */
	}
	#mle-canvas {
		display: block;
		cursor: grab;
		border-radius: 8px;
		box-shadow: 0 24px 80px rgba(0,0,0,0.6), 0 0 40px rgba(22,235,235,0.06);
		transition: transform 0.45s ease;
		transform-origin: center;
		z-index: 1;
		position: relative;
	}
	#drag-hint {
		position: absolute;
		bottom: 2.5rem;
		width: 100%;
		text-align: center;
		pointer-events: none;
		color: rgba(255,255,255,0.6);
		font-size: 0.72rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0;
		transition: opacity 0.5s ease;
		z-index: 3;
	}
	#drag-hint.flashing {
		animation: hint-flash 1.2s ease-in-out infinite;
	}
	@keyframes hint-flash {
		0%, 100% { opacity: 0.15; }
		50%       { opacity: 0.9; }
	}
	#hero-ui {
		position: absolute;
		bottom: 2.5rem;
		width: 100%;
		text-align: center;
		pointer-events: none;
	}
	.hero-scroll-hint {
		color: rgba(255,255,255,0.35);
		font-size: 0.72rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}
	#hero-dots {
		display: flex;
		justify-content: center;
		gap: 8px;
	}
	.hero-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: rgba(255,255,255,0.2);
		transition: background 0.3s;
	}
	.hero-dot.active { background: #16ebeb; }

	#top-nav {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 100;
		padding: 1.2rem 2rem;
		display: flex;
		gap: 1.5rem;
	}
	#top-nav a {
		color: rgba(255,255,255,0.7);
		text-decoration: none;
		font-size: 1.2rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: color 0.2s;
	}
	#top-nav a:hover { color: #fff; }
	/* --- Responsive --- */
	@media (max-width: 700px) {
		#hero-title { font-size: 2.2rem; }
	}
</style>

<script>
(function () {
  if (history.scrollRestoration) history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);

  const ZOOM_STEPS     = 6;
  const IMG_SCALE_STEPS = 4;
  const TEXT_FULL_STEP  = 5;
  const DRAG_PER_STEP   = 80; // px of horizontal drag per angle step

  const canvas   = document.getElementById('mle-canvas') as HTMLCanvasElement;
  const titleEl  = document.getElementById('hero-title')!;
  const bgImg    = document.getElementById('bg-img') as HTMLImageElement;
  const lineMl   = document.getElementById('line-ml')!;
  const dragHint = document.getElementById('drag-hint')!;

  // ── Audio ─────────────────────────────────────────────────────────────────
  const bgMusic   = new Audio('/sounds/morning_breeze.wav');
  bgMusic.loop    = true;
  bgMusic.volume  = 0.2;
  const rippleSfx = new Audio('/sounds/water_droplet.wav');
  rippleSfx.volume = 0.5;

  let audioStarted = false;
  let lastRipplePlay = 0;
  const RIPPLE_THROTTLE = 300;

  function startAudio() {
    if (audioStarted) return;
    audioStarted = true;
    bgMusic.play().catch(() => {});
  }

  // ── Angle images (angle3 = front view is default) ─────────────────────────
  const ANGLE_SRCS = [
    '/images/aggie.png',
    '/images/aggie_angle1.png',
    '/images/aggie_angle2.png',
    '/images/aggie_angle3.png',
    '/images/aggie_angle4.png',
  ];
  const angleImgs = ANGLE_SRCS.map(src => {
    const i = new Image(); i.src = src; return i;
  });

  let angleIndex     = 0; // start with aggie.png
  let isDragging     = false;
  let dragStartX     = 0;
  let dragStartAngle = 0;
  let hasDragged     = false;

  function setAngle(idx: number) {
    const clamped = Math.max(0, Math.min(ANGLE_SRCS.length - 1, idx));
    if (clamped === angleIndex) return;
    angleIndex = clamped;
    const src = angleImgs[angleIndex];
    if (src.complete && src.naturalWidth > 0) loadPixels(src);
    else src.addEventListener('load', () => loadPixels(src), { once: true });
    bgImg.src = ANGLE_SRCS[angleIndex];
    if (!hasDragged) { hasDragged = true; dragHint.style.opacity = '0'; }
  }

  // ── Ripple state ──────────────────────────────────────────────────────────
  let W = 0, H = 0;
  let ctx: CanvasRenderingContext2D | null = null;
  let srcPixels = new Uint8ClampedArray(0);
  let waveA = new Float32Array(0);
  let waveB = new Float32Array(0);
  let output: ImageData | null = null;
  let mx = -1, my = -1, pActive = false;
  const DAMP = 0.985;

  function initCanvas(src: HTMLImageElement) {
    const maxW = Math.min(window.innerWidth * 0.9, 900);
    const maxH = window.innerHeight * 0.82;
    const ratio = src.naturalWidth / src.naturalHeight;
    if (maxW / ratio <= maxH) { W = Math.round(maxW); H = Math.round(maxW / ratio); }
    else                       { H = Math.round(maxH); W = Math.round(maxH * ratio); }
    canvas.width  = W; canvas.height = H;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    ctx    = canvas.getContext('2d')!;
    waveA  = new Float32Array(W * H);
    waveB  = new Float32Array(W * H);
    output = ctx.createImageData(W, H);
    loadPixels(src);
  }

  function loadPixels(src: HTMLImageElement) {
    if (!ctx || !W || !H) return;
    const tmp = document.createElement('canvas');
    tmp.width = W; tmp.height = H;
    const tCtx = tmp.getContext('2d')!;
    tCtx.drawImage(src, 0, 0, W, H);
    srcPixels = tCtx.getImageData(0, 0, W, H).data;
    output!.data.set(srcPixels);
    waveA.fill(0); waveB.fill(0);
  }

  function tick() {
    if (!ctx || !output || !W) { requestAnimationFrame(tick); return; }
    if (pActive && mx > 1 && mx < W - 2 && my > 1 && my < H - 2) {
      const ci = my * W + mx;
      waveB[ci] = 200;
      waveB[ci-1] = waveB[ci+1] = waveB[ci-W] = waveB[ci+W] = 100;
    }
    for (let y = 1; y < H - 1; y++) {
      for (let x = 1; x < W - 1; x++) {
        const i = y * W + x;
        waveA[i] = (waveB[i-1] + waveB[i+1] + waveB[i-W] + waveB[i+W]) * 0.5 - waveA[i];
        waveA[i] *= DAMP;
      }
    }
    const dst = output!.data;
    for (let y = 1; y < H - 1; y++) {
      for (let x = 1; x < W - 1; x++) {
        const i = y * W + x;
        const dx = Math.round((waveA[i-1] - waveA[i+1]) * 0.4);
        const dy = Math.round((waveA[i-W] - waveA[i+W]) * 0.4);
        const sx = Math.max(0, Math.min(W - 1, x + dx));
        const sy = Math.max(0, Math.min(H - 1, y + dy));
        const si = (sy * W + sx) << 2;
        const di = i << 2;
        dst[di]   = srcPixels[si];   dst[di+1] = srcPixels[si+1];
        dst[di+2] = srcPixels[si+2]; dst[di+3] = srcPixels[si+3];
      }
    }
    ctx.putImageData(output!, 0, 0);
    [waveA, waveB] = [waveB, waveA];
    requestAnimationFrame(tick);
  }

  // ── Canvas interaction ────────────────────────────────────────────────────
  canvas.addEventListener('mousedown', e => {
    isDragging     = true;
    dragStartX     = e.clientX;
    dragStartAngle = angleIndex;
    canvas.style.cursor = 'grabbing';
    e.preventDefault();
  });

  canvas.addEventListener('mousemove', e => {
    const r = canvas.getBoundingClientRect();
    mx = Math.floor((e.clientX - r.left) * W / r.width);
    my = Math.floor((e.clientY - r.top)  * H / r.height);
    if (isDragging) {
      const steps = Math.round((e.clientX - dragStartX) / DRAG_PER_STEP);
      setAngle(dragStartAngle + steps);
    } else {
      pActive = true;
      const now = Date.now();
      if (now - lastRipplePlay > RIPPLE_THROTTLE) {
        lastRipplePlay = now;
        rippleSfx.currentTime = 0;
        rippleSfx.play().catch(() => {});
      }
    }
  });

  canvas.addEventListener('mouseleave', () => {
    pActive = false;
    if (isDragging) { isDragging = false; canvas.style.cursor = 'grab'; }
  });

  window.addEventListener('mouseup', () => {
    if (isDragging) { isDragging = false; canvas.style.cursor = 'grab'; }
  });

  // Touch: horizontal drag on canvas = angle, vertical swipe on window = zoom
  let canvasTouchStartX = 0, canvasTouchStartAngle = 0;
  let isHorizontalTouch = false;

  canvas.addEventListener('touchstart', e => {
    canvasTouchStartX     = e.touches[0].clientX;
    canvasTouchStartAngle = angleIndex;
    isHorizontalTouch     = false;
  }, { passive: true });

  canvas.addEventListener('touchmove', e => {
    const dx = e.touches[0].clientX - canvasTouchStartX;
    const dy = e.touches[0].clientY - e.touches[0].clientY;
    if (!isHorizontalTouch && Math.abs(dx) > 12) isHorizontalTouch = true;
    if (isHorizontalTouch) setAngle(canvasTouchStartAngle + Math.round(dx / DRAG_PER_STEP));
  }, { passive: true });

  canvas.addEventListener('touchend', () => { isHorizontalTouch = false; }, { passive: true });

  // ── Scroll zoom sequence ──────────────────────────────────────────────────
  let zoomStep = 0;

  function applyVisuals() {
    const imgScale = 1 + (Math.min(zoomStep, IMG_SCALE_STEPS) / IMG_SCALE_STEPS) * 0.25;
    canvas.style.transform = `scale(${imgScale})`;

    const textOpacity = zoomStep < TEXT_FULL_STEP
      ? 0.15 + (zoomStep / IMG_SCALE_STEPS) * 0.6 : 1.0;
    titleEl.style.opacity = textOpacity.toString();

    const textScale = 1 + (Math.min(zoomStep, IMG_SCALE_STEPS) / IMG_SCALE_STEPS) * 0.2;
    titleEl.style.transform = `scale(${textScale})`;

    const mlVisible = zoomStep >= TEXT_FULL_STEP;
    lineMl.style.maxHeight = mlVisible ? '5rem' : '0';
    lineMl.style.opacity   = mlVisible ? '1'    : '0';

    // Drag hint: appears at last scroll step, flashes until user drags
    const showHint = zoomStep >= ZOOM_STEPS && !hasDragged;
    dragHint.style.opacity = showHint ? '1' : '0';
    if (showHint) dragHint.classList.add('flashing');
    else dragHint.classList.remove('flashing');

    // Blurred background matches current angle
    bgImg.style.opacity = zoomStep >= ZOOM_STEPS ? '1' : '0';

    bgMusic.volume = 0.2 + (Math.min(zoomStep, IMG_SCALE_STEPS) / IMG_SCALE_STEPS) * 0.8;
  }

  let heroInView = true;
  let lastStep = 0;
  const STEP_DELAY = 150;

  function advance(dir: number) {
    const now = Date.now();
    if (now - lastStep < STEP_DELAY) return;
    lastStep = now;
    if (dir > 0) {
      if (zoomStep < ZOOM_STEPS) { zoomStep++; applyVisuals(); }
    } else {
      if (zoomStep > 0) { zoomStep--; applyVisuals(); }
    }
  }

  window.addEventListener('wheel', (e: WheelEvent) => {
    if (!heroInView) return;
    if (e.deltaY < 0 && zoomStep === 0) return;
    e.preventDefault();
    startAudio();
    advance(e.deltaY > 0 ? 1 : -1);
  }, { passive: false });

  let touchY0 = 0;
  window.addEventListener('touchstart', (e: TouchEvent) => { touchY0 = e.touches[0].clientY; startAudio(); }, { passive: true });
  window.addEventListener('touchmove',  (e: TouchEvent) => {
    if (heroInView && zoomStep !== 0) e.preventDefault();
  }, { passive: false });
  window.addEventListener('touchend', (e: TouchEvent) => {
    if (!heroInView) return;
    const dy = touchY0 - e.changedTouches[0].clientY;
    if (Math.abs(dy) > 40) advance(dy > 0 ? 1 : -1);
  }, { passive: true });

  // ── Start ─────────────────────────────────────────────────────────────────
  function start() {
    initCanvas(angleImgs[angleIndex]);
    bgImg.src = ANGLE_SRCS[angleIndex];
    applyVisuals();
    tick();
  }

  const startImg = angleImgs[angleIndex];
  if (startImg.complete && startImg.naturalWidth > 0) start();
  else startImg.addEventListener('load', start, { once: true });
})();
</script>
