---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';

const projects = [
  {
    slug: 'rag',
    title: 'Q&A Chatbot via Retrieval Augmented Generation',
    desc: 'RAG pipeline that vectorizes PDFs and performs semantic search before generating grounded LLM responses.',
    media: '/images/RAG/Q&A_pipeline.png',
    mediaType: 'image', // 'image' | 'gif' | 'video'
    tags: ['LLM', 'RAG', 'Vector DB', 'NLP'],
  },
  {
    slug: 'pilot-workload',
    title: 'Pilot Workload Estimation via Multimodal ML',
    desc: 'Multimodal ML model estimating eVTOL pilot stress levels from 7 biometric modalities. Ground truth via NASA TLX.',
    media: '/images/pilot_workload/sim_setup.png',
    mediaType: 'image',
    tags: ['Multimodal ML', 'Signal Processing', 'PyTorch', 'eVTOL'],
  },
  {
    slug: 'on-device-ml',
    title: 'On-Device ML Deployment & Optimization',
    desc: 'Compressed a 72M-parameter garment try-on model onto Jetson Nano 4GB via quantization, pruning, and distillation.',
    media: '/images/on_device_ml/jetson1.png',
    mediaType: 'image',
    tags: ['Model Compression', 'Pruning', 'Knowledge Distillation', 'Jetson Nano'],
  },
  {
    slug: 'aircraft-traj-pred',
    title: 'Aircraft Motion Forecasting',
    desc: 'Transformer-based joint prediction model trained on 200 days of FAA SWIM trajectory data from KSEA and KEWR.',
    media: '/images/aircraft_traj_pred/pipeline.png',
    mediaType: 'image',
    tags: ['Motion Forecasting', 'Transformer', 'Graph Neural Net', 'Aviation'],
  },
  {
    slug: 'emotion-recog',
    title: 'Human Facial Emotion Recognition & Classification',
    desc: 'CNN classifier on AffectNet (291K images, 8 labels) achieving ~70% validation accuracy with full error analysis.',
    media: '/images/emotion_recog/baseCNN_results.png',
    mediaType: 'image',
    tags: ['CNN', 'Computer Vision', 'AffectNet', 'Classification'],
  },
];
---
<Layout>
  <SiteNav current="projects" />
  <section id="projects-page">
    <div class="page-header">
      <h1>Projects</h1>
    </div>
    <div class="projects-grid">
      {projects.map(p => (
        <a href={`/projects/${p.slug}`} class="project-card">
          <figure class="card-figure">
            {p.mediaType === 'video' ? (
              <video loop muted playsinline disablepictureinpicture preload="none" aria-label={p.title}>
                <source src={p.media} type="video/mp4" />
              </video>
            ) : (
              <img src={p.media} alt={p.title} loading="lazy" />
            )}
            <div class="card-overlay"></div>
            <div class="card-caption">
              <h2>{p.title}</h2>
              <p>{p.desc}</p>
            </div>
          </figure>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  #projects-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 80px 8vw 120px;
  }
  .page-header {
    margin-bottom: 2rem;
  }
  h1 {
    font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    font-size: clamp(2.8rem, 6vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
  }

  /* Billboard grid — 3 cols, 3 rows, each project a different size */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 300px 240px 190px;
    gap: 6px;
  }

  /* RAG: wide landscape (cols 1–2, row 1) */
  .project-card:nth-child(1) { grid-column: 1 / 3; grid-row: 1; }
  /* Pilot: tall portrait (col 3, rows 1–2) */
  .project-card:nth-child(2) { grid-column: 3;     grid-row: 1 / 3; }
  /* On-Device: square (col 1, row 2) */
  .project-card:nth-child(3) { grid-column: 1;     grid-row: 2; }
  /* Aircraft: square (col 2, row 2) */
  .project-card:nth-child(4) { grid-column: 2;     grid-row: 2; }
  /* Emotion: full-width banner (cols 1–3, row 3) */
  .project-card:nth-child(5) { grid-column: 1 / 4; grid-row: 3; }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    overflow: hidden;
  }

  .card-figure {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    background: #111;
  }

  .card-figure img,
  .card-figure video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }
  .project-card:hover .card-figure img,
  .project-card:hover .card-figure video {
    transform: scale(1.04);
  }

  /* Dark gradient overlay, fades in on hover */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.82) 0%,
      rgba(0,0,0,0.4) 45%,
      rgba(0,0,0,0.08) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }
  .project-card:hover .card-overlay {
    opacity: 1;
  }

  /* Text caption, slides up and fades in on hover */
  .card-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 22px;
    z-index: 2;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .project-card:hover .card-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .card-caption h2 {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 5px;
    line-height: 1.35;
    text-shadow: 0 1px 6px rgba(0,0,0,0.6);
  }
  .card-caption p {
    font-size: 0.73rem;
    color: rgba(255,255,255,0.72);
    margin: 0;
    line-height: 1.55;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tablet */
  @media (max-width: 760px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: 200px 180px 180px;
    }
    .project-card:nth-child(1) { grid-column: 1 / 3; grid-row: 1; }
    .project-card:nth-child(2) { grid-column: 1;     grid-row: 2; }
    .project-card:nth-child(3) { grid-column: 2;     grid-row: 2; }
    .project-card:nth-child(4) { grid-column: 1;     grid-row: 3; }
    .project-card:nth-child(5) { grid-column: 2;     grid-row: 3; }
  }

  /* Mobile */
  @media (max-width: 480px) {
    .projects-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(5, 220px);
    }
    .project-card:nth-child(n) { grid-column: 1; }
    .project-card:nth-child(1) { grid-row: 1; }
    .project-card:nth-child(2) { grid-row: 2; }
    .project-card:nth-child(3) { grid-row: 3; }
    .project-card:nth-child(4) { grid-row: 4; }
    .project-card:nth-child(5) { grid-row: 5; }
  }
</style>
